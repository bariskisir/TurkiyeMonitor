{
  "name": "turkiyemonitor",
  "version": "1.1.0",
  "description": "A professional CLI tool for monitoring Turkiye agenda data in real time.",
  "main": "dist/cli.js",
  "types": "dist/cli.d.ts",
  "type": "module",
  "bin": {
    "turkiyemonitor": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node dist/cli.js",
    "prepack": "npm run build"
  },
  "keywords": [
    "turkiye",
    "agenda",
    "cli",
    "news",
    "economy",
    "trends",
    "monitor"
  ],
  "author": "bariskisir",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bariskisir/turkiyemonitor.git"
  },
  "bugs": {
    "url": "https://github.com/bariskisir/turkiyemonitor/issues"
  },
  "homepage": "https://github.com/bariskisir/turkiyemonitor#readme",
  "dependencies": {
    "axios": "1.18.0",
    "chalk": "^4.1.2",
    "cheerio": "^1.0.0",
    "cli-progress": "^3.12.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "puppeteer": "^24.37.5",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^24.10.1",
    "@types/xml2js": "^0.4.14",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "basic-ftp": "5.3.1",
    "follow-redirects": "1.16.0",
    "ip-address": "10.2.0",
    "undici": "7.24.1"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "screenshot.png"
  ]
